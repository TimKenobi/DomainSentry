# DomainSentry Configuration
# Copy this file to .env and fill in your values

# SMTP Configuration for email reports
SMTP_HOST=smtp.example.com
SMTP_PORT=25
EMAIL_FROM=domainsentry@example.com
EMAIL_RECIPIENTS=security@example.com,admin@example.com

# Output directory (optional - defaults to ./output)
# OUTPUT_DIR=/app/output

# Timezone (optional - defaults to UTC)
TZ=UTC
